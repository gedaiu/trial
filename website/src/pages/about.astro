---
import { getEntry, render } from "astro:content";
import Docs from "../layouts/Docs.astro";
import { outline } from "../lib/docs";

const readme = await getEntry("readme", "readme");
const { Content } = await render(readme!);
---
<Docs title="About" current="about" headings={outline(readme!)}>
  <h1>About</h1>
  <Content />
</Docs>
