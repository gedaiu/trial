---
import { render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { allDocs, docTitle, outline } from "../../lib/docs";

export async function getStaticPaths() {
  return (await allDocs()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Docs title={docTitle(entry)} current={entry.id} headings={outline(entry)}>
  <Content />
</Docs>
