---
import Docs from "../../layouts/Docs.astro";
import { allDocs, docTitle, firstSentence } from "../../lib/docs";

const docs = await allDocs();
---
<Docs title="Documentation" current="index">
  <h1>Documentation</h1>
  <p class="lead">Start with the tutorial, then read about the part of trial you want to change.</p>

  <div class="doc-cards">
    {docs.map((entry) => (
      <a class="doc-card" href={`/doc/${entry.id}.html`}>
        <h3>{docTitle(entry)}</h3>
        <p>{firstSentence(entry.body ?? "")}</p>
      </a>
    ))}
  </div>
</Docs>
