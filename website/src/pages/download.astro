---
import Page from "../layouts/Page.astro";
import { version } from "../lib/version";

const dependency = `"dependencies": {
  "trial": "~>${version}"
}`;

const compilers = [
  { icon: "ubuntu.svg", name: "Ubuntu", command: "sudo apt install ldc dub" },
  { icon: "fedora.svg", name: "Fedora", command: "sudo dnf install ldc dub" },
];
---
<Page title="Trial - Download">
  <main class="band band-grey">
    <article class="container prose">
      <h1>Download <small>v{version}</small></h1>

      <p class="lead">Trial needs a D compiler and dub:</p>
      <div class="platforms">
        {compilers.map(({ icon, name, command }) => (
          <div class="platform">
            <img src={`/assets/${icon}`} alt="">
            <h3>{name}</h3>
            <pre><code>{command}</code></pre>
          </div>
        ))}
      </div>

      <p class="lead">Trial ships as a dub package. Add it to your <code>dub.json</code>:</p>
      <pre><code>{dependency}</code></pre>

      <p>Then run your tests as usual:</p>
      <pre><code>dub test</code></pre>

      <p>All releases are listed on <a href="https://code.dlang.org/packages/trial">code.dlang.org</a>.</p>
    </article>
  </main>
</Page>
